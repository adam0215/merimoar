{
	"name": "merimoar",
	"private": true,
	"license": "AGPL-3.0-only",
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "bun run --cwd packages/web dev",
		"dev:agent": "bun run --cwd packages/agent-worker dev",
		"dev:convex": "convex dev",
		"generate-routes": "bun run --cwd packages/web generate-routes",
		"build": "bun run --cwd packages/web build",
		"build:agent": "bun run --cwd packages/agent-worker build",
		"preview": "bun run --cwd packages/web preview",
		"typecheck": "bun run --workspaces --if-present typecheck",
		"format": "biome format",
		"lint": "oxlint --deny-warnings",
		"lint:fix": "oxlint --fix",
		"check": "oxlint --deny-warnings && biome check",
		"check:write": "oxlint --fix && biome check --write",
		"test": "vitest",
		"test:once": "vitest run"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@edge-runtime/vm": "^5.0.0",
		"@types/node": "^22.10.2",
		"convex": "^1.43.0",
		"oxlint": "^1.75.0",
		"oxlint-tailwindcss": "^1.6.0",
		"typescript": "^6.0.2",
		"vitest": "^4.1.10"
	},
	"packageManager": "bun@1.3.14",
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lightningcss"
		]
	},
	"engines": {
		"node": ">=22.11.0"
	},
	"dependencies": {}
}
