# WorkOS
# WorkOS client ID (required)
WORKOS_CLIENT_ID=
# WorkOS API key (required)
WORKOS_API_KEY=
# AuthKit callback URL (required)
WORKOS_REDIRECT_URI=
# Session cookie encryption password (at least 32 characters) (required)
WORKOS_COOKIE_PASSWORD=
# WorkOS API hostname
WORKOS_API_HOSTNAME=
# WorkOS webhook signing secret (required by the Convex deployment)
WORKOS_WEBHOOK_SECRET=
# WorkOS Pipes provider slug; defaults to resend in Development
WORKOS_RESEND_PROVIDER_SLUG=
# Optional alternate user-management JWT issuer (Convex deployment only)
WORKOS_JWT_ISSUER=

# Convex
# Convex deployment name
CONVEX_DEPLOYMENT=
# Convex deployment URL (required)
VITE_CONVEX_URL=
# Same deployment URL for the standalone Node agent worker (required by worker)
CONVEX_URL=
# Shared secret used only by server-side hosts and the Convex deployment
# Generate at least 32 random characters; never expose it through a VITE_* variable.
AGENT_RUNTIME_SECRET=
AGENT_RUN_EXECUTION_TIMEOUT_MS=300000
# Convex pushes to this worker URL; both sides share the HMAC signing secret.
AGENT_RUN_PUSH_URL=
AGENT_RUN_PUSH_SIGNING_SECRET=

# Agent runtime
# Used by @merimoar/agent-worker and the optional @merimoar/agent TUI.
OPENAI_API_KEY=
